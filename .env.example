# --- App ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
# 開發/測試環境用 true 才會放行 /api/poc/* 端點；正式環境一定要 false 或拿掉
ENABLE_POC=true

# --- Database (Postgres) ---
# Supabase Transaction pooled URL (port 6543) — 給 runtime
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# Supabase Direct URL (port 5432) — 給 prisma migrate
DIRECT_DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Google OAuth (跑 npm run setup:gcloud + docs/setup-oauth-client.md 取得) ---
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Session (iron-session) ---
# 32+ chars random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_PASSWORD=

# --- Token encryption (AES-256-GCM) ---
# 32 bytes base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
