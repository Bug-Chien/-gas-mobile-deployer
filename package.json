    "@uiw/react-codemirror": "^4.25.10",
    "autoprefixer": "^10.5.0",
    "googleapis": "^172.0.0",
    "iron-session": "^8.0.4",
    "next": "^15.5.18",
    "postcss": "^8.5.15",
    "prisma": "^6.19.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
